# Скопируйте в .env и при необходимости поправьте.
# Все значения имеют безопасные значения по умолчанию для локального запуска.

JWT_SECRET_KEY=dev-only-secret-change-me-0123456789

# 1 — при старте создаются демо-данные (см. scripts/seed.py), 0 — база остаётся пустой.
SEED_DEMO_DATA=1

# Порты, публикуемые на хосте. Меняйте, если 8000 или 5173 уже заняты.
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Адрес клиента: используется для ссылок-приглашений и для списка разрешённых origin.
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Путь к репозиторию фронтенда относительно этого файла.
# Нужен только для запуска всего стенда: docker compose --profile full up --build
FRONTEND_DIR=../myroute-frontend
